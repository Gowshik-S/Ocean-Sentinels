# Database Configuration
# Local SQLite Configuration (Primary)
DATABASE_URL=sqlite+aiosqlite:///./database/ocean_hazard.db
DATABASE_URL_LOCAL=sqlite+aiosqlite:///backend/database/ocean_hazard.db

# Local Database Connection Details
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ocean_hazard_db
DB_USER=ocean_user
DB_PASSWORD=ocean_password

# AWS RDS Configuration (For future use)
# DATABASE_URL_AWS=postgresql+asyncpg://username:password@your-rds-endpoint.amazonaws.com:5432/ocean_hazard_db
# DB_HOST_AWS=your-rds-endpoint.amazonaws.com
# DB_PORT_AWS=5432
# DB_NAME_AWS=ocean_hazard_db
# DB_USER_AWS=your_username
# DB_PASSWORD_AWS=your_password

# JWT Configuration
SECRET_KEY=your-super-secret-jwt-key-here-change-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS Configuration (Optional for local development)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=ocean-hazard-storage

# Redis Configuration (Optional for local development)
REDIS_URL=redis://localhost:6379
REDIS_URL_CLOUD=redis://your-redis-endpoint.amazonaws.com:6379

# Application Configuration
DEBUG=True
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:5500", "http://localhost:5500", "https://your-frontend-domain.com"]

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Mapbox Configuration (Optional)
MAPBOX_ACCESS_TOKEN=your-mapbox-token
