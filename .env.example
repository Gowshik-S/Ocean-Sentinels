# Database Configuration
# AWS RDS Configuration
DATABASE_URL=postgresql+asyncpg://your_user:your_password@your_host:5432/your_database
DATABASE_URL_LOCAL=sqlite+aiosqlite:///backend/database/ocean_hazard.db

# Database Connection Details
DB_HOST=your_aws_rds_host
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_username
DB_PASSWORD=your_database_password

# JWT Configuration
SECRET_KEY=your-super-secret-jwt-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS Configuration (Optional)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=your-aws-region
AWS_S3_BUCKET=your-s3-bucket-name

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379
REDIS_URL_CLOUD=redis://your-redis-endpoint:6379

# Application Configuration
DEBUG=False
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["https://your-frontend-domain.com"]

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Mapbox Configuration (Optional)
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token

# Railway Configuration (automatically provided by Railway)
# RAILWAY_ENVIRONMENT=production
# RAILWAY_SERVICE_NAME=your-service-name